NODE_ENV=development
PORT=3005
# Development is loopback-only. Strict deployments may set 0.0.0.0 explicitly.
DGOP_BIND_HOST=127.0.0.1

# PostgreSQL connection for local development. Replace the password/port/database
# with your own local values. Do not commit real credentials in .env files.
DB_NAME=dgop_dev
DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:55436/dgop_dev?schema=public

# Use a long random value in every shared or production-like environment.
JWT_SECRET=replace-with-at-least-32-random-characters
# Dedicated encryption/HMAC key for protected saved-search and analytics queries.
# Keep this distinct from JWT_SECRET so authentication-key rotation cannot make
# encrypted search history unreadable.
DGOP_SEARCH_QUERY_KEY=replace-with-a-different-32-character-random-secret
# Dedicated HMAC/encryption key for versioned BPMN workflow snapshots. Keep it
# distinct from JWT_SECRET and DGOP_SEARCH_QUERY_KEY so key rotation is isolated.
DGOP_BPMN_SIGNING_SECRET=replace-with-a-third-32-character-random-secret
# Supports values like 8h, 30m, or bare seconds such as 28800.
JWT_EXPIRES_IN=8h
HEALTH_INCLUDE_DETAILS=false
DGOP_AUDIT_FAIL_CLOSED=true

# Local Angular dev server / public tunnel origin.
# Production-like external origins must be HTTPS; loopback HTTP is only for local smoke tests.
PUBLIC_ORIGIN=http://localhost:4205
CORS_ORIGINS=http://localhost:4205
# Comma-separated trusted proxy IP/CIDR ranges or Express presets. Keep false
# for direct deployments; the local Cloudflare demo uses loopback.
DGOP_TRUST_PROXY=false

# Seed accounts are for local demo data only. Override them before any shared demo.
SEED_ADMIN_EMAIL=admin@dgop.local
SEED_ADMIN_PASSWORD=replace-with-local-demo-password
SEED_PERSON_PASSWORD=replace-with-local-demo-password

# Required for integration webhook ingestion in every environment.
DGOP_WEBHOOK_TOKEN=replace-with-at-least-32-random-characters

# Optional: set true only when you want seed data to show active risks/queues.
DGOP_SEED_RISK_SCENARIO=false
# Explicitly opt in to the six-type access matrix sample inventory and grants.
# Keep false for production and non-demo environments.
DGOP_SEED_ACCESS_MATRIX_SAMPLES=false
# Seeding canonicalizes RBAC and resets selected sample datasets. Keep both
# safeguards false except for an explicitly approved local/disposable database.
DGOP_ALLOW_DESTRUCTIVE_SEED=false
DGOP_ALLOW_PRODUCTION_SEED=false

# Evidence file storage. Use object storage or a secured mounted path for production.
EVIDENCE_STORAGE_DIR=storage/evidence
EVIDENCE_MAX_BYTES=15728640
WORKFLOW_ATTACHMENT_STORAGE_DIR=storage/workflow-attachments
WORKFLOW_ATTACHMENT_MAX_BYTES=15728640
