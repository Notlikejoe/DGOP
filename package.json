{
  "name": "dgop",
  "version": "0.1.0",
  "private": true,
  "description": "Data Governance Operations Platform (DGOP) - Angular + Node.js + PostgreSQL",
  "scripts": {
    "install:all": "npm --prefix apps/api install && npm --prefix apps/web install",
    "db:generate": "node scripts/db.mjs generate",
    "db:status": "node scripts/db.mjs status",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:deploy": "node scripts/db.mjs deploy",
    "db:seed": "node scripts/db.mjs seed",
    "db:seed:local": "node scripts/seed-local.mjs",
    "db:sync-demo-credentials": "node scripts/sync-demo-credentials.mjs",
    "db:local:start": "node scripts/local-postgres.mjs start",
    "db:local:stop": "node scripts/local-postgres.mjs stop",
    "db:local:status": "node scripts/local-postgres.mjs status",
    "demo:prepare": "node scripts/prepare-demo-env.mjs",
    "local:prepare": "node scripts/prepare-demo-env.mjs --local",
    "local:setup": "node scripts/local.mjs setup",
    "local:check": "node scripts/local.mjs check",
    "local:credentials": "node scripts/local.mjs credentials",
    "start:local": "node scripts/local.mjs start",
    "test:local": "node --test scripts/test/local.test.mjs",
    "test:local:integration": "node scripts/test/local.integration.mjs",
    "qa:api": "node scripts/api-quality.mjs",
    "qa:web": "node scripts/web-quality.mjs",
    "qa:ui": "node scripts/ui-smoke.mjs",
    "qa": "npm run qa:api && npm run qa:web",
    "qa:release": "node scripts/qa-release.mjs",
    "build:web": "npm --prefix apps/web run build",
    "build:api": "npm --prefix apps/api run build",
    "build": "npm run build:web && npm run build:api",
    "start": "node apps/api/dist/main.js",
    "start:demo": "node scripts/start-demo.mjs",
    "dev": "node scripts/dev.mjs",
    "publish:external": "node scripts/publish.mjs",
    "publish:external:dry-run": "node scripts/publish.mjs --dry-run"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26"
  }
}
