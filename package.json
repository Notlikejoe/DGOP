{
  "name": "dgop",
  "version": "0.1.0",
  "private": true,
  "description": "Data Governance Operations Platform (DGOP) - Angular + Node.js + PostgreSQL",
  "scripts": {
    "install:all": "npm --prefix apps/api install && npm --prefix apps/web install",
    "db:generate": "node scripts/db.mjs generate",
    "db:status": "node scripts/db.mjs status",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:deploy": "node scripts/db.mjs deploy",
    "db:seed": "node scripts/db.mjs seed",
    "db:seed:local": "node scripts/seed-local.mjs",
    "db:seed:ai-review-demo": "node scripts/seed-ai-review-example.mjs --local-demo",
    "db:seed:ai-risk-library": "node scripts/seed-ai-risk-library.mjs --local-demo",
    "db:sync-demo-credentials": "node scripts/sync-demo-credentials.mjs",
    "db:local:start": "node scripts/local-postgres.mjs start",
    "db:local:stop": "node scripts/local-postgres.mjs stop",
    "db:local:status": "node scripts/local-postgres.mjs status",
    "demo:prepare": "node scripts/demo.mjs prepare",
    "local:prepare": "node scripts/prepare-demo-env.mjs --local",
    "local:setup": "node scripts/local.mjs setup",
    "local:check": "node scripts/local.mjs check",
    "local:credentials": "node scripts/local.mjs credentials",
    "start:local": "node scripts/local.mjs start",
    "test:local": "node --test scripts/test/local.test.mjs",
    "test:local:integration": "node scripts/test/local.integration.mjs",
    "qa:api": "node scripts/api-route-scan.test.mjs && node scripts/api-quality.mjs",
    "qa:web": "node scripts/web-quality.mjs",
    "qa:ui": "node scripts/ui-smoke.mjs",
    "qa": "npm run qa:api && npm run qa:web",
    "qa:release": "node scripts/qa-release.mjs",
    "build:web": "npm --prefix apps/web run build",
    "build:api": "npm --prefix apps/api run build",
    "build": "npm run build:web && npm run build:api",
    "start": "node apps/api/dist/main.js",
    "start:demo": "node scripts/start-demo.mjs",
    "dev": "node scripts/dev.mjs",
    "publish:external": "node scripts/publish.mjs",
    "publish:external:dry-run": "node scripts/publish.mjs --dry-run",
    "test:database": "node scripts/test-ai-foundation.mjs",
    "demo:setup": "node scripts/demo.mjs setup",
    "demo:start": "node scripts/demo.mjs start",
    "demo:check": "node scripts/demo.mjs check",
    "demo:stop": "node scripts/demo.mjs stop",
    "demo:verify": "node scripts/demo.mjs verify",
    "demo:backup": "node scripts/demo.mjs backup",
    "demo:restore": "node scripts/demo.mjs restore",
    "demo:recover": "node scripts/demo.mjs recover",
    "demo:preflight": "node scripts/demo.mjs preflight",
    "demo:soak": "node scripts/demo.mjs soak",
    "test:demo": "node --test scripts/test/demo.test.mjs",
    "demo:browser": "node scripts/demo-browser-qa.mjs",
    "test:demo:native": "node scripts/test-demo-native.mjs",
    "test:demo:runtime": "node scripts/test-demo-runtime.mjs",
    "test:demo:journeys": "node scripts/test-demo-journeys.mjs",
    "test:demo:soak": "node scripts/test-demo-soak.mjs",
    "test:demo:restored-runtime": "node scripts/test-demo-restored-runtime.mjs",
    "test:demo:register-browser": "node scripts/test-demo-register-browser.mjs",
    "test:demo:browser-writes": "node scripts/test-demo-browser-writes.mjs"
  },
  "engines": {
    "node": "24.19.x"
  },
  "packageManager": "npm@11.13.0"
}
